# Copy to .env.local and fill in. .env.local is gitignored.
#
# Each variable is comma-separated, aligned by index across all of them.
# Example below configures three environments: Development, Production, Stage.

VITE_ENV_NAMES=Development,Production,Stage
VITE_ENV_PROJECT_IDS=your-dev-id,your-prod-id,your-stage-id
VITE_ENV_ANON_KEYS=eyJ...dev,eyJ...prod,eyJ...stage

# Per-environment allowed email domains.
# Each entry is '|'-separated within itself; empty = allow all.
# Example below: Dev allows any, Prod restricts to kiv.dev, Stage restricts to kiv.dev.
VITE_ENV_ALLOWED_DOMAINS=,kiv.dev,kiv.dev
